    {
      "id": "QAogiIVCD7MdAIRX4kWQP",
      "type": "text",
      "x": -89.59736165197143,
      "y": 473.1424382232648,
      "width": 220,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aGV",
      "roundness": null,
      "seed": 575124515,
      "version": 284,
      "versionNonce": 1650191629,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783429897315,
      "link": null,
      "locked": false,
      "text": "- 100M DAUs / secs in day\n\n= 10^8 / 10^5\n= 10^3\n~1000 rps (only for read)\n\nconsider write as well\n",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- 100M DAUs / secs in day\n\n= 10^8 / 10^5\n= 10^3\n~1000 rps (only for read)\n\nconsider write as well\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "rb5o_KX6Qfz82pp0iTHHX",
      "type": "text",
      "x": 215.53125,
      "y": 677.4375,
      "width": 413.6000061035156,
      "height": 320,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
