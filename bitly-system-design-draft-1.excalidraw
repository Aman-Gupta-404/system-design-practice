      "seed": 247052621,
      "version": 549,
      "versionNonce": 113117987,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783418433813,
      "link": null,
      "locked": false,
      "text": "REST API Design\n\n- Create Short URL\n    Request: POST /api/v1/urls\n    Body: {\n              originalUrl: string,\n              customAlias?: string,\n              expirationTime?: Date\n          }\n    Response: shortUrl\n\n- Redirection\n    Request: GET /:shortCode\n    Response: HTTP 302 redirect to original URL\n    use 302 or 301\n    302",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "REST API Design\n\n- Create Short URL\n    Request: POST /api/v1/urls\n    Body: {\n              originalUrl: string,\n              customAlias?: string,\n              expirationTime?: Date\n          }\n    Response: shortUrl\n\n- Redirection\n    Request: GET /:shortCode\n    Response: HTTP 302 redirect to original URL\n    use 302 or 301\n    302",
      "autoResize": true,
      "lineHeight": 1.25
    },
