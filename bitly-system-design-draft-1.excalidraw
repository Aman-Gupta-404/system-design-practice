      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "method 2: Use Counter\nStore a counter in Redis\n- encode the counter and then increment it\n- the every URL generated is unique",
      "autoResize": true,
      "lineHeight": 1.25
