    {
      "id": "9-903m_lxsI4CI-rOrw5R",
      "type": "text",
      "x": -262.27679031475486,
      "y": 456.91533551718817,
      "width": 439.99945068359375,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
