      "index": "ac",
      "roundness": null,
      "seed": 1433510471,
      "version": 245,
      "versionNonce": 227930953,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787479066320,
      "link": null,
      "locked": false,
      "text": "100M DAU\n1B ticket booking\nread:write = 10:1\n\n100M DAU * 10^5 = 100 * 10^6 / 10^5\n= 10^3 rps = 1000 rps\nconsidering spikes = 1000 * 10 = 10k rps\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "100M DAU\n1B ticket booking\nread:write = 10:1\n\n100M DAU * 10^5 = 100 * 10^6 / 10^5\n= 10^3 rps = 1000 rps\nconsidering spikes = 1000 * 10 = 10k rps\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
