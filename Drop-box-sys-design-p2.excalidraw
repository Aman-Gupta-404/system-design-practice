      "roundness": null,
      "seed": 732322757,
      "version": 733,
      "versionNonce": 317873547,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783864681455,
      "link": null,
      "locked": false,
      "text": "Not inclined to using CDN because\n- It gets harder to invalidate the CDN in case of delete or update\n- this can be tackled by using file versioning and each version gets \n  its own objectKey, so the s3 link will point to the latest url\n  but, if there are frequent updates, it defetes the purpose of caching\n- I would use it only when I have versioning in my system and repeatedly clear\n  old versions to save the storage",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Not inclined to using CDN because\n- It gets harder to invalidate the CDN in case of delete or update\n- this can be tackled by using file versioning and each version gets \n  its own objectKey, so the s3 link will point to the latest url\n  but, if there are frequent updates, it defetes the purpose of caching\n- I would use it only when I have versioning in my system and repeatedly clear\n  old versions to save the storage",
      "autoResize": true,
      "lineHeight": 1.25
    },
