    {
      "id": "B7R0jhR01aQbPPq_RMZ-S",
      "type": "text",
      "x": 246.5,
      "y": 146.49031696944792,
      "width": 466.3999938964844,
      "height": 220,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a2",
      "roundness": null,
      "seed": 997941872,
      "version": 568,
      "versionNonce": 1315339920,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783921165520,
      "link": null,
      "locked": false,
      "text": "Functional Requirements\n- User should be able to see the products\n- User should be able to add the products to cart\n- User should be able to checkout and place the order\n- User should be able to track the order\n\nNon-functional Requirements\n- Consistency > Aailability\n- Low latency on fetching the products\n- Handle high scale\n- Live update of order status",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements\n- User should be able to see the products\n- User should be able to add the products to cart\n- User should be able to checkout and place the order\n- User should be able to track the order\n\nNon-functional Requirements\n- Consistency > Aailability\n- Low latency on fetching the products\n- Handle high scale\n- Live update of order status",
      "autoResize": true,
      "lineHeight": 1.25
    },
