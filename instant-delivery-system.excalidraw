    },
    {
      "id": "EeGipTHoTLvGTDEk0dnct",
      "type": "text",
      "x": 1065.6215047238543,
      "y": 176.3263773619271,
      "width": 413.6000061035156,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a4V",
      "roundness": null,
      "seed": 2028302992,
      "version": 706,
      "versionNonce": 1967324816,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783921128169,
      "link": null,
      "locked": false,
      "text": "Scale Calculation\n- Assume 100M DAU, 1M products\n- Read heavy system --> write:read :: 1:100\n100 * 10^6 * 10 = 1000M reads = 10^9 = 1B reads\n10^9 / 10^5 = 10^4 = 10k rps\n\n10k * 5 = 50K rps\n\nRedis - 95% hit rate\n50k * 5% = 2.5k rps on DB",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Scale Calculation\n- Assume 100M DAU, 1M products\n- Read heavy system --> write:read :: 1:100\n100 * 10^6 * 10 = 1000M reads = 10^9 = 1B reads\n10^9 / 10^5 = 10^4 = 10k rps\n\n10k * 5 = 50K rps\n\nRedis - 95% hit rate\n50k * 5% = 2.5k rps on DB",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "QYZzdTU3F4uiw5fHa_shP",
      "type": "text",
      "x": 248.70347452761462,
      "y": 390.53539246004686,
      "width": 396,
      "height": 380,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
