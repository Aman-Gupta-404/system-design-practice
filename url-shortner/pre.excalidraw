      "isDeleted": false,
      "boundElements": null,
      "updated": 1789499442478,
      "link": null,
      "locked": false,
      "text": "Entities\n- Users\n- Short URL\n- Long URL\n- URL MetaData\n\nAPIs\n- Create Short URL\nEndpoint: POST: /api/v1/url\nbody: { url: string, expiration: date }\nResponse: Short URL\n\n- Redirect Endpoint\nEndpoint: GET: /<short_code>\nResponse: Redirect (301 / 302) --> original URL",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Entities\n- Users\n- Short URL\n- Long URL\n- URL MetaData\n\nAPIs\n- Create Short URL\nEndpoint: POST: /api/v1/url\nbody: { url: string, expiration: date }\nResponse: Short URL\n\n- Redirect Endpoint\nEndpoint: GET: /<short_code>\nResponse: Redirect (301 / 302) --> original URL",
      "autoResize": true,
      "lineHeight": 1.25
    },
